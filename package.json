{
  "name": "@linkseek/opencode-cognee",
  "version": "0.3.2",
  "description": "OpenCode v2 long-term memory plugin backed by Cognee REST (per-user datasets, auto-recall, idle capture)",
  "type": "module",
  "main": ".opencode/plugins/cognee/index.ts",
  "files": [
    ".opencode/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/plugin.test.mjs",
    "migrate": "node scripts/migrate-mem.mjs",
    "provision": "node scripts/provision-users.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "@opencode/plugin": "2.3.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cognee",
    "memory",
    "multi-user"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-seek/opencode-cognee.git"
  },
